MOCKSVR_APP_ENV=development
MOCKSVR_SERVER_HOST=0.0.0.0
MOCKSVR_SERVER_PORT=8080
MOCKSVR_DATABASE_URL=postgres://mocksvr:mocksvr@localhost:5432/mocksvr?sslmode=disable
MOCKSVR_CACHE_REDIS_ADDR=localhost:6379
MOCKSVR_CACHE_REDIS_PASSWORD=
MOCKSVR_CACHE_REDIS_DB=0
MOCKSVR_CACHE_REDIS_TTL=60s
# Leave MOCKSVR_AI_PROVIDER empty to disable AI. Options: openai | ollama | openrouter
MOCKSVR_AI_PROVIDER=
MOCKSVR_AI_BASE_URL=
MOCKSVR_AI_API_KEY=
MOCKSVR_AI_MODEL=
MOCKSVR_AI_TIMEOUT=60s

# Auth is disabled by default. Set MOCKSVR_AUTH_ENABLED=true to enable.
MOCKSVR_AUTH_ENABLED=false
MOCKSVR_AUTH_API_KEYS=
MOCKSVR_AUTH_WORKSPACE_TOKENS=
MOCKSVR_AUTH_JWT_SECRET=
MOCKSVR_AUTH_JWT_ISSUER=mocksvr
MOCKSVR_AUTH_JWT_AUDIENCE=mocksvr
MOCKSVR_AUTH_JWT_TTL=1h

# Dashboard
MOCKSVR_DASHBOARD_ENABLED=false

MOCKSVR_LOG_LEVEL=debug
